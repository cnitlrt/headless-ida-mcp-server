# Absolute path to a licensed IDA Pro headless executable (idat/idat64)
IDA_PATH=/path/to/ida/idat
HOST=127.0.0.1
PORT=8888
TRANSPORT=stdio
# TRANSPORT=streamable-http
# TRANSPORT=sse
IDA_READ_ONLY=true
IDA_MAX_SESSIONS=4
IDA_STARTUP_TIMEOUT=120
IDA_REQUEST_TIMEOUT=60
# Optional allowed input/export directories, separated by os.pathsep (: on Linux)
# IDA_ALLOWED_ROOTS=/home/user/samples:/home/user/analysis
# Idle database sessions expire after 15 minutes; 0 disables idle expiry.
IDA_IDLE_TIMEOUT=900
